        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="TitleColor" Value="{StaticResource PlaceholderCampo}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Acento}" />
        <Setter Property="TextColor" Value="{StaticResource AcentoTexto}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="44" />
