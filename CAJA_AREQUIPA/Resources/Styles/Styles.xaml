    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Borde}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="BorderColor" Value="{StaticResource BordeCampo}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <!-- Plantilla común de las listas: título, subtítulo, detalle y una etiqueta de estado -->
    <DataTemplate x:Key="PlantillaItem">
        <Border Style="{StaticResource FilaLista}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="{Binding Titulo}" />
                    <Label Style="{StaticResource Subtitulo}" Text="{Binding Subtitulo}" />
                    <Label
                        IsVisible="{Binding TieneDetalle}"
                        Style="{StaticResource Subtitulo}"
                        Text="{Binding Detalle}" />
                </VerticalStackLayout>
                <Border
                    Grid.Column="1"
                    Padding="8,3"
                    BackgroundColor="{StaticResource NavActivo}"
                    IsVisible="{Binding TieneEtiqueta}"
                    StrokeShape="RoundRectangle 10,10,10,10"
                    StrokeThickness="0"
                    VerticalOptions="Start">
                    <Label
                        FontAttributes="Bold"
                        FontSize="11"
                        Text="{Binding Etiqueta}"
                        TextColor="{Binding ColorEtiqueta}" />
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
