<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CajaArequipa.UI.MarcoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource Fondo}"
    NavigationPage.HasNavigationBar="False"
    Title="Caja Arequipa">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Cabecera: logo, nombre del sistema y accesos -->
        <Grid
            Grid.Row="0"
            Padding="16,14"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12">
            <Border
                Grid.Column="0"
                BackgroundColor="{StaticResource Acento}"
                HeightRequest="40"
                StrokeShape="RoundRectangle 10,10,10,10"
                StrokeThickness="0"
                WidthRequest="40">
                <Image
                    HeightRequest="22"
                    HorizontalOptions="Center"
                    Source="ico_banco.png"
                    VerticalOptions="Center"
                    WidthRequest="22" />
            </Border>

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="1"
                VerticalOptions="Center">
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Caja Arequipa" />
                <Label Style="{StaticResource Subtitulo}" Text="Sistema de gestión bancaria" />
            </VerticalStackLayout>

            <HorizontalStackLayout
                Grid.Column="2"
                Spacing="16"
                VerticalOptions="Center">
                <Image
                    HeightRequest="20"
                    Source="ico_campana.png"
                    WidthRequest="20" />
                <Image
                    HeightRequest="20"
                    Source="ico_usuario.png"
                    WidthRequest="20" />
            </HorizontalStackLayout>
        </Grid>

        <BoxView
            Grid.Row="1"
            Margin="10,0"
            Color="{StaticResource Borde}"
            HeightRequest="1" />

        <!-- Menú horizontal: solo se ve en pantallas angostas (celular) -->
        <ScrollView
            x:Name="scrMenuH"
            Grid.Row="2"
            Margin="10,10,10,0"
            HorizontalScrollBarVisibility="Never"
            IsVisible="False"
            Orientation="Horizontal">
            <HorizontalStackLayout x:Name="navH" Spacing="8" />
        </ScrollView>

        <!-- Cuerpo: menú lateral + sección activa -->
        <Grid
            x:Name="cuerpo"
            Grid.Row="3"
            ColumnDefinitions="260,*"
            ColumnSpacing="10"
            Padding="10">
            <Border
                x:Name="panelMenu"
                Grid.Column="0"
                Padding="8"
                BackgroundColor="{StaticResource Panel}"
                Stroke="{StaticResource Borde}"
                StrokeShape="RoundRectangle 10,10,10,10"
                StrokeThickness="1">
                <VerticalStackLayout x:Name="navV" Spacing="4" />
            </Border>

            <ContentView x:Name="contenedor" Grid.Column="1" />
        </Grid>
    </Grid>
</ContentPage>
